# ===================================
# MOTUS V2 - CONFIGURATION BACKEND
# ===================================
# Copiez ce fichier vers .env et remplacez par vos vraies valeurs
# ⚠️ NE JAMAIS POUSSER LE FICHIER .env SUR GITHUB !

# 🔧 CONFIGURATION SERVEUR
PORT=3000
NODE_ENV=development

# 🗄️ BASE DE DONNÉES MYSQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql_ici
DB_NAME=motus

# 🔑 SÉCURITÉ JWT (IMPORTANT: Générez un secret fort !)
# Utilisez : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre_super_secret_jwt_minimum_64_caracteres_aleatoires_ici

# 📧 SERVICE EMAIL GMAIL
# 1. Activer l'authentification à 2 facteurs sur Gmail
# 2. Générer un "Mot de passe d'application" (pas votre mot de passe Gmail normal)
# 3. Utiliser ce mot de passe d'application ci-dessous
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_gmail_16_caracteres
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# 🌐 URLS APPLICATION (ajustez selon votre environnement)
CLIENT_URL=http://localhost:4200
SERVER_URL=http://localhost:3000

# ⚠️  IMPORTANT SÉCURITÉ :
# - JWT_SECRET doit faire au minimum 64 caractères aléatoires
# - EMAIL_PASS doit être un "mot de passe d'application" Gmail, pas votre mot de passe normal
# - Ne jamais mettre de vrais mots de passe dans ce fichier .env.example
# - Toujours copier vers .env et modifier avec vos vraies valeurs
# - Le fichier .env est dans .gitignore et ne sera pas poussé sur GitHub
